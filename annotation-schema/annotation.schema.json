{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fixinglabel.local/schemas/annotation.schema.json",
  "title": "FixingLabel Annotation Document",
  "type": "object",
  "required": ["document_id", "source_pdf", "meta", "pages"],
  "additionalProperties": false,
  "properties": {
    "document_id": { "type": "string", "minLength": 1 },
    "source_pdf": { "type": "string", "minLength": 1 },
    "meta": {
      "type": "object",
      "required": ["coord_space", "version"],
      "additionalProperties": false,
      "properties": {
        "coord_space": { "type": "string", "enum": ["pdf"] },
        "version": { "type": "integer", "minimum": 1 },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["page_number", "width", "height", "elements"],
        "additionalProperties": false,
        "properties": {
          "page_number": { "type": "integer", "minimum": 1 },
          "width": { "type": "number", "exclusiveMinimum": 0 },
          "height": { "type": "number", "exclusiveMinimum": 0 },
          "elements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "label", "bbox"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "label": { "type": "string", "minLength": 1 },
                "bbox": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "items": { "type": "number" }
                },
                "score": { "type": "number", "minimum": 0, "maximum": 1 },
                "locked": { "type": "boolean" },
                "hidden": { "type": "boolean" },
                "notes": { "type": "string" },
                "text": { "type": "string" },
                "reading_order": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    }
  }
}
